# Android release signing — copy to `android/key.properties` (git-ignored) and fill in.
# Generate a keystore first:
#   keytool -genkey -v -keystore ~/zoonze-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias zoonze
#
# storeFile is resolved relative to android/app (use an absolute path to be safe).
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=zoonze
storeFile=/absolute/path/to/zoonze-release.jks
