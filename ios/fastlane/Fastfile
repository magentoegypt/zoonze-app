default_platform(:ios)

platform :ios do
  desc "Build the prod flavor and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    # Distribution certificate + provisioning profile, stored in a private git
    # repo by `match`. Seed it once (from any machine, no Mac CSR needed):
    #   cd ios && bundle exec fastlane match appstore
    match(
      type: "appstore",
      app_identifier: "com.zoonze.shop",
      api_key: api_key,
      readonly: true,
    )

    # Flutter drives the entrypoint + dart-defines; signing comes from match via
    # ExportOptions.plist (set teamID there).
    sh(
      "flutter", "build", "ipa", "--release",
      "--export-options-plist", "ExportOptions.plist",
      "--target", "../lib/main_prod.dart",
      "--dart-define-from-file=../config/prod.json",
    )

    ipa = Dir["../build/ios/ipa/*.ipa"].first
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
  end
end
